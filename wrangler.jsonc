{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "branded-qr-tool",
  "main": "src/worker.js",
  // Serve on a subdomain so the main dancewithb.fun site is untouched.
  // `wrangler deploy` creates the DNS record and certificate (the zone must be
  // on this Cloudflare account). Never attach the bare domain here.
  "routes": [{ "pattern": "qr.dancewithb.fun", "custom_domain": true }],
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker only runs for short links and the admin API; the site itself
    // is served straight from static assets (free, no Worker invocation).
    "run_worker_first": ["/c/*", "/api/*"]
  },
  "d1_databases": [
    // No database_id: `wrangler deploy` creates and binds the database for you.
    {
      "binding": "DB",
      "database_name": "branded-qr-links",
      "database_id": "3cba390f-2849-471e-91ad-5c4268c18807"
    }
  ],
  "vars": {
    // The permanent public origin that goes into printed QR codes, e.g.
    // "https://qr.dancewithb.fun". Leave empty to use whichever origin you
    // create links from.
    "PUBLIC_BASE_URL": "https://qr.dancewithb.fun"
  }
}
